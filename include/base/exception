namespace std {
	using terminate_handler = void (*)();
	terminate_handler get_terminate() noexcept;
	terminate_handler set_terminate(terminate_handler f) noexcept;
	[[noreturn]] void terminate() noexcept;

	int uncaught_exceptions() noexcept;

	class exception {
	private:
		std::size_t _ref_count = 0;

	public:
		FSTDCXX_FORCEINLINE exception() noexcept {
		}
		FSTDCXX_FORCEINLINE exception(const exception &rhs) noexcept : _ref_count(rhs._ref_count) {
		}
		FSTDCXX_FORCEINLINE exception &operator=(const exception &rhs) noexcept {
			_ref_count = rhs._ref_count;
			return *this;
		}
		FSTDCXX_API virtual ~exception();
		FSTDCXX_API virtual const char *what();
	};
	class bad_exception : public exception {
	};
	class nested_exception : public exception {
	};

