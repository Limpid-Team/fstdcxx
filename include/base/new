#ifndef _FSTDCXX_BASE_NEW_
#define _FSTDCXX_BASE_NEW_

#include "_fstdcxx/cxx_basedefs.hh"
#include <cstddef>

FSTDCXX_FORCEINLINE void *operator new(size_t, void *p) noexcept { return p; }
FSTDCXX_FORCEINLINE void *operator new[](size_t, void *p) noexcept { return p; }
FSTDCXX_FORCEINLINE void operator delete(void *, void *) noexcept {}
FSTDCXX_FORCEINLINE void operator delete[](void *, void *) noexcept {}
FSTDCXX_API void operator delete(void *, size_t) noexcept;

namespace std {
	/// @brief Obtain a pointer to the object located at the storage @p p refers to.
	template <typename T>
	[[nodiscard]] constexpr T *launder(T *p) noexcept {
		return __builtin_launder(p);
	}
}

#endif
